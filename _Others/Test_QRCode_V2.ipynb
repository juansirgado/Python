   "source": [
    "# Importing library\n",
    "import qrcode\n",
    " \n",
    "# Data to be encoded\n",
    "data = 'QR Code using make() function'\n",
    " \n",
    "# Encoding data using make() function\n",
    "img = qrcode.make(data)\n",
    " \n",
    "# Saving as an image file\n",
    "img.save('MyQRCode1.png')\n",
    "\n",
    "# Show the image file\n",
    "img.get_image()"
   ]
  }
 ],
